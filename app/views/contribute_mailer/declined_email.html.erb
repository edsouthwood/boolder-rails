<% problem_name = @contribution.problem&.name_with_fallback || @contribution.problem_name %>

<p><%= t("contribute_mailer.greeting", name: @contribution.contributor_name.presence || t("contribute_mailer.fallback_name")) %></p>

<p><%= t("contribute_mailer.declined_email.body", problem: problem_name) %></p>

<% if @contribution.moderator_note.present? %>
  <p><%= t("contribute_mailer.declined_email.note_intro") %></p>
  <blockquote><%= @contribution.moderator_note %></blockquote>
<% end %>

<p><%= t("contribute_mailer.signoff") %></p>
