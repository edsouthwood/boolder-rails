<% add_breadcrumb "Dartmoor", admin_areas_path %>
<% add_breadcrumb @area.name, admin_area_problems_path(area_slug: @area.slug, circuit_id: "first") %>
<% add_breadcrumb "Import problem list", nil, class: "active" %>
<% area_toolbar @area %>

<h1 class="my-3">Import a problem list into <%= @area.name %></h1>

<div class="max-w-3xl space-y-4">
  <p class="text-sm text-gray-600">
    Paste a list of the area's boulders and their problems. Each boulder's name goes on its own line, followed by its
    problems, one per line, starting with a tab: the problem's name, then its grade (e.g. <code>f6B</code> or <code>6b</code>).
    A list of the boulder names at the top is optional; when there is one, any other lines under a name are treated as notes and ignored.
  </p>
  <p class="text-sm text-gray-600">
    Nothing changes until you've checked the preview. Problems that already exist are matched by name and put on their boulder;
    new boulders are created without an outline, ready to be drawn in the boulder editor.
  </p>

  <%= form_with url: admin_area_problem_list_preview_path(area_slug: @area.slug), multipart: true, class: "space-y-3" do %>
    <label class="block">
      <span class="block text-sm font-medium text-gray-700 mb-1">Paste the list</span>
      <%= text_area_tag :text, nil, rows: 18, spellcheck: false,
            class: "block w-full rounded-md border-gray-300 shadow-sm font-mono text-xs focus:border-granite focus:ring-granite" %>
    </label>
    <label class="block">
      <span class="block text-sm font-medium text-gray-700 mb-1">…or choose a text file</span>
      <%= file_field_tag :file, accept: ".txt,text/plain", class: "text-sm" %>
    </label>
    <button type="submit" class="btn">Preview</button>
  <% end %>
</div>
