<% problem = @contribution.problem %>

<% add_breadcrumb "Dartmoor", admin_areas_path %>
<% add_breadcrumb problem.area.name, admin_area_problems_path(area_slug: problem.area.slug, circuit_id: problem.circuit&.id) if problem %>
<% add_breadcrumb "Problem ##{problem.id}", admin_problem_path(problem) if problem %>
<% add_breadcrumb "Contribution ##{@contribution.id}", nil, class: "active" %>

<div class="mb-4">
  <%= link_to "<- contributions", admin_contributions_path(state: session[:contributions_filter].presence), class: "text-emerald-600" %>
</div>

<div class="mt-10 sm:mt-0">
  <div class="md:grid md:grid-cols-4 md:gap-6">
    <div class="mt-5 md:mt-0 md:col-span-2">
      <%= form_with model: [:admin, @contribution] do |form| %>
        <div class="shadow overflow-hidden sm:rounded-md">
          <div class="px-4 py-5 bg-white sm:p-6">
            <div class="grid grid-cols-6 gap-6">
              <%= render "form", form: form %>
            </div>
          </div>
          <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
            <button type="submit" class="btn">Update</button>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-5 md:mt-0 md:col-span-2">
      <% if @nearby_topos.any? %>
        <div class="mb-4 rounded bg-amber-50 border border-amber-300 px-4 py-3 text-sm text-amber-800">
          &#9888; <%= pluralize(@nearby_topos.size, "existing photo") %> found within 10 m &mdash; check below before importing.
        </div>
      <% end %>

      <% if problem = @contribution.problem %>
        <p class="my-4">
          <%= problem_circle_view(problem) %>
          <%= link_to problem.name_with_fallback, admin_problem_path(problem), class: "ml-2", target: "_blank" %>
        </p>
      <% else %>
        <div class="my-4 rounded border border-gray-200 bg-gray-50 p-4">
          <p class="text-sm font-semibold text-gray-800 mb-1">Unlisted problem</p>
          <% if @contribution.problem_name.present? %><p class="text-sm">Name: <%= @contribution.problem_name %></p><% end %>
          <% if @contribution.problem_url.present? %><p class="text-sm break-all">URL: <%= @contribution.problem_url %></p><% end %>

          <%= form_with url: create_problem_admin_contribution_path(@contribution), method: :post, class: "mt-4 space-y-3" do %>
            <p class="text-xs text-gray-500">Create a real problem from this submission, then accept the contribution to import the photo, line and GPS.</p>

            <div>
              <label class="block text-xs font-medium text-gray-700">Area</label>
              <%= select_tag "problem[area_id]",
                    options_from_collection_for_select(Area.order(:name), :id, :name),
                    include_blank: "Select an area…", class: "mt-1 block w-full rounded-md border-gray-300 text-sm" %>
            </div>

            <div>
              <label class="block text-xs font-medium text-gray-700">Name</label>
              <%= text_field_tag "problem[name]", @contribution.problem_name, class: "mt-1 block w-full rounded-md border-gray-300 text-sm" %>
            </div>

            <div class="flex gap-3">
              <div class="flex-1">
                <label class="block text-xs font-medium text-gray-700">Grade</label>
                <%= select_tag "problem[grade]",
                      options_for_select(Problem::DISPLAY_GRADE_VALUES),
                      include_blank: "—", class: "mt-1 block w-full rounded-md border-gray-300 text-sm" %>
              </div>
              <div class="flex-1">
                <label class="block text-xs font-medium text-gray-700">Steepness</label>
                <%= select_tag "problem[steepness]",
                      options_for_select(Problem::STEEPNESS_VALUES, "other"),
                      class: "mt-1 block w-full rounded-md border-gray-300 text-sm" %>
              </div>
            </div>

            <button type="submit" class="btn">Create &amp; link problem</button>
          <% end %>
        </div>
      <% end %>

      <div class="mb-4">
        <div><%= @contribution.contributor_name %></div>
        <div class="text-gray-400 mb-4"><%= @contribution.contributor_email %></div>
      </div>

      <div class="mb-4 text-xs text-gray-500 space-y-0.5">
        <div>Submitted <%= @contribution.created_at.to_fs(:long) %></div>
        <% if @contribution.accepted_at %>
          <div>Accepted <%= @contribution.accepted_at.to_fs(:long) %><%= " by #{@contribution.reviewed_by}" if @contribution.reviewed_by %></div>
        <% elsif @contribution.closed_at %>
          <div>Closed <%= @contribution.closed_at.to_fs(:long) %><%= " by #{@contribution.reviewed_by}" if @contribution.reviewed_by %></div>
        <% end %>
      </div>

      <div class="mb-4">
        <%= simple_format @contribution.comment %>
      </div>

      <% if @contribution.ukc_url.present? %>
        <div class="mb-4">
          <span class="text-sm font-medium text-gray-600">UKC: </span>
          <%= link_to @contribution.ukc_url, @contribution.ukc_url, target: "_blank",
                class: "text-sm text-emerald-600 hover:underline break-all" %>
        </div>
      <% end %>

      <div class="mb-4">
        <% if location = @contribution.location %>
          <span>GPS: </span>
          <%= [location.lat, location.lon].join(",") %>
        <% end %>
      </div>

      <% if @contribution.line_coordinates.present? && @contribution.photos.any? %>
        <div class="mb-4 relative" data-controller="line-preview"
             data-line-preview-coordinates-value="<%= @contribution.line_coordinates %>">
          <%= image_tag(@contribution.photos.first, class: "w-full object-cover block rounded",
                data: { "line-preview-target": "image" }) %>
          <canvas data-line-preview-target="canvas"
                  class="absolute top-0 left-0 pointer-events-none rounded"
                  style="width:100%;height:100%"></canvas>
        </div>
      <% elsif @contribution.line_coordinates.present? && @existing_topo %>
        <div class="mb-4">
          <p class="text-xs text-gray-500 mb-1">Line drawn on <%= link_to "Topo ##{@existing_topo.id}", edit_admin_topo_path(@existing_topo), class: "text-emerald-600 hover:underline" %>:</p>
          <div class="relative" data-controller="line-preview"
               data-line-preview-coordinates-value="<%= @contribution.line_coordinates %>">
            <%= cdn_image_tag(@existing_topo.photo.variant(:medium), class: "w-full object-cover block rounded",
                  data: { "line-preview-target": "image" }) %>
            <canvas data-line-preview-target="canvas"
                    class="absolute top-0 left-0 pointer-events-none rounded"
                    style="width:100%;height:100%"></canvas>
          </div>
        </div>
      <% else %>
        <% @contribution.photos.each do |photo| %>
          <%= image_tag(photo, class: "w-full object-cover mb-2") %>
        <% end %>
      <% end %>

      <% @contribution.line_drawings.each do |line_drawing| %>
        <%= image_tag(line_drawing, class: "w-full object-cover") %>
      <% end %>

      <% @contribution.location_drawings.each do |location_drawing| %>
        <%= image_tag(location_drawing, class: "w-full object-cover") %>
      <% end %>
    </div>
  </div>
</div>

<% if @contribution.location.present? %>
  <div class="mt-8 border-t pt-6">
    <h3 class="text-sm font-semibold text-gray-700 mb-3">Existing photos within 10 m</h3>
    <% if @nearby_topos.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        <% @nearby_topos.each do |topo| %>
          <%= link_to edit_admin_topo_path(topo), target: "_blank", class: "block" do %>
            <%= cdn_image_tag topo.photo.variant(:thumb),
                  class: "w-full h-28 object-cover rounded border border-gray-200" %>
            <% prob = topo.problems.first %>
            <% if prob %>
              <p class="text-xs text-gray-600 mt-1 truncate"><%= prob.name_with_fallback %></p>
              <p class="text-xs text-gray-400 truncate"><%= prob.area.name %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400 italic">No existing photos found nearby.</p>
    <% end %>
  </div>
<% end %>
