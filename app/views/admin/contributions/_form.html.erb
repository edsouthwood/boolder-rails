<div class="col-span-6 sm:col-span-2">
  <%= form.label :state %>
  <%= form.select :state, Contribution::STATES %>
</div>

<div class="col-span-6">
  <%= form.label :moderator_note, "Note to contributor (optional)" %>
  <%= form.text_area :moderator_note, rows: 2, placeholder: "Shown in the email when a contribution is declined", class: "block w-full rounded-md border-gray-300 shadow-sm sm:text-sm" %>
</div>

<div class="col-span-6 mt-2">
  <p class="text-sm font-medium text-gray-700 mb-2">Apply on accept</p>
  <div class="space-y-2">
    <% if @contribution.existing_topo_id.present? %>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= form.check_box :apply_photo, checked: true %>
        <%= @contribution.drawing_parts.to_sentence.upcase_first.presence || "Nothing drawn" %> on Topo #<%= @contribution.existing_topo_id %> (no new photo is created)
      </label>
    <% elsif @same_photo_topo %>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= form.check_box :apply_photo, checked: true %>
        <%= @contribution.drawing_parts.to_sentence.upcase_first.presence || "Nothing drawn" %> on
        <%= link_to "Topo ##{@same_photo_topo.id}", edit_admin_topo_path(@same_photo_topo), class: "text-granite hover:underline", target: "_blank" %>
        <span class="text-xs text-gray-500">(that's this very photo, so no new topo)</span>
      </label>
    <% elsif @contribution.photos.any? %>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= form.check_box :apply_photo, checked: true %>
        <%= @contribution.line_coordinates.present? ? "Photo & line" : "Photo (no line drawn)" %>
        <% extras = @contribution.drawing_parts - [ "line" ] %>
        <% if extras.any? %><span class="text-xs text-gray-500">+ <%= extras.to_sentence %></span><% end %>
        <span class="text-xs text-gray-500">(on the photo chosen below)</span>
      </label>
    <% else %>
      <p class="text-sm text-gray-400 italic">No photo or line to import</p>
    <% end %>

    <% if @contribution.location.present? %>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= form.check_box :apply_gps, checked: true %>
        GPS coordinates
        <% if @contribution.problem&.location.present? %>
          <span class="text-xs text-gray-400">(problem already has a location &mdash; won't be overwritten)</span>
        <% end %>
      </label>
    <% else %>
      <p class="text-sm text-gray-400 italic">No GPS in this contribution</p>
    <% end %>
  </div>
  <p class="text-xs text-gray-400 mt-1">Only applied when state is set to "accepted".</p>
</div>

<% if @merge_candidates.any? %>
  <div class="col-span-6 mt-4 border-t pt-4">
    <p class="text-sm font-medium text-gray-700">Which photo?</p>
    <p class="text-xs text-gray-500 mb-2">
      If one of these shows the same face, put the problem on it rather than adding another topo.
      The line was drawn on the contributor's photo, so it won't fit another: it comes across
      undrawn, and the workbench shows their drawing while you redraw it.
    </p>
    <div class="space-y-2">
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <%= radio_button_tag "contribution[merge_topo_id]", "", @contribution.merge_topo_id.blank? %>
        New topo from the contributed photo
      </label>
      <% @merge_candidates.each do |topo| %>
        <label class="flex items-center gap-3 text-sm text-gray-700 cursor-pointer">
          <%= radio_button_tag "contribution[merge_topo_id]", topo.id, @contribution.merge_topo_id == topo.id %>
          <%= cdn_image_tag topo.photo.variant(:thumb), class: "w-24 h-16 object-cover rounded border border-gray-200" %>
          <span>
            Topo #<%= topo.id %>
            <% names = topo.problems.reorder(nil).limit(3).map(&:name_with_fallback) %>
            <% if names.any? %><span class="block text-xs text-gray-500 truncate max-w-[14rem]"><%= names.to_sentence %><%= "…" if topo.lines.size > 3 %></span><% end %>
            <% unless topo.published %><span class="block text-xs text-amber-700">not published yet</span><% end %>
          </span>
        </label>
      <% end %>
    </div>
  </div>
<% end %>
