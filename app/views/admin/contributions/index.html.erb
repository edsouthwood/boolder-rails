<div class="flex items-baseline gap-3 mb-4 pt-4 px-4 sm:px-0">
  <h2 class="text-2xl font-bold">Contributions</h2>
  <% if @pending_count > 0 %>
    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-sm font-medium text-amber-800">
      <%= pluralize(@pending_count, "pending") %>
    </span>
  <% end %>
</div>

<%= form_with url: admin_contributions_path, method: :get, class: "my-4" do |form| %>
  <div class="w-1/2">
    <label for="state" class="block text-sm font-medium text-gray-700">State</label>
    <%= form.select :state, Contribution::STATES, { selected: @state, include_blank: "All" }, { onchange: 'this.form.submit()', class: "mt-1 block w-full md:w-1/3 rounded-md border-gray-300 py-2 pl-3 pr-10 text-base focus:border-emerald-500 focus:outline-none focus:ring-emerald-500 sm:text-sm" } %>
  </div>
<% end %>

<%= form_with url: bulk_close_admin_contributions_path, method: :post, data: { controller: "bulk-select" } do %>
  <%# Bulk action bar — revealed by the bulk-select controller when rows are selected %>
  <div data-bulk-select-target="bar" class="hidden my-3 flex flex-wrap items-center gap-3 rounded-md bg-gray-50 border border-gray-200 px-4 py-3">
    <span class="text-sm text-gray-700"><span data-bulk-select-target="count">0</span> selected</span>
    <%= text_field_tag :moderator_note, nil, placeholder: "Optional note to contributors (included in the decline email)", class: "flex-1 min-w-[16rem] rounded-md border-gray-300 text-sm" %>
    <button type="submit" class="btn bg-red-600 hover:bg-red-700"
            data-turbo-confirm="Close the selected contributions and email the contributors?">
      Close selected
    </button>
  </div>

  <div class="flex flex-col my-6">
    <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
        <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left">
                  <input type="checkbox" data-bulk-select-target="all" data-action="bulk-select#toggleAll" aria-label="Select all">
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Id</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Photo</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Problem</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Area</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Submitted</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">State</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contributor</th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Comment</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @contributions.each do |contribution| %>
                <tr class="align-top h-16">
                  <td class="px-4 py-2">
                    <input type="checkbox" name="contribution_ids[]" value="<%= contribution.id %>"
                           data-bulk-select-target="checkbox" data-action="bulk-select#refresh">
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap">
                    <%= link_to contribution.id, edit_admin_contribution_path(contribution), class: "text-sm text-emerald-600" %>
                  </td>
                  <td class="px-4 py-2">
                    <% if contribution.photos.attached? %>
                      <%= link_to edit_admin_contribution_path(contribution) do %>
                        <%= image_tag contribution.photos.first.variant(resize_to_limit: [ 80, 80 ]), class: "w-12 h-12 object-cover rounded border border-gray-200" %>
                      <% end %>
                    <% else %>
                      <span class="text-xs text-gray-300">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap">
                    <span class="text-sm font-bold">
                      <%= link_to(contribution.problem&.name || contribution.problem_name || "(empty)", edit_admin_contribution_path(contribution)) %>
                    </span>
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap">
                    <span class="text-sm text-gray-600"><%= contribution.problem&.area&.name || "-" %></span>
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap">
                    <span class="text-sm text-gray-500" title="<%= contribution.created_at %>"><%= contribution.created_at.to_date.to_fs(:long) %></span>
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap">
                    <span class="my-4 inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-800 ring-1 ring-inset ring-blue-600/20">
                      <%= contribution.state %>
                    </span>
                  </td>
                  <td class="px-4 py-2 whitespace-nowrap">
                    <div class="text-sm"><%= contribution.contributor_name %></div>
                  </td>
                  <td class="px-4 py-2">
                    <span class="text-sm text-gray-500"><%= truncate(contribution.comment, length: 60) %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-4">
          <%= paginate @contributions %>
        </div>
      </div>
    </div>
  </div>
<% end %>
