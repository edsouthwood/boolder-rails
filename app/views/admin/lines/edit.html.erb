<% add_breadcrumb "Dartmoor", admin_areas_path %>
<% add_breadcrumb @line.problem.area.name, admin_area_problems_path(area_slug: @line.problem.area.slug, circuit_id: @line.problem.circuit&.id) %>
<% add_breadcrumb "Problem ##{@line.problem.id}", admin_problem_path(@line.problem) %>
<% add_breadcrumb "Line ##{@line.id}", nil, class: "active" %>

<div class="my-3">
  <%= problem_circle_view_with_name(@line.problem) %>
</div>
<div class="my-3">
  <%= link_to "Topo ##{@line.topo.id}", edit_admin_topo_path(@line.topo) %>
</div>

<div data-controller="topo-editor">
  <div class="my-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    <span class="font-semibold">Clicks add:</span>
    <label class="flex items-center space-x-1">
      <input type="radio" name="topo_editor_mode" value="line" checked data-action="topo-editor#setMode">
      <span>Line points <span style="color:#ff2626">&#9679;</span></span>
    </label>
    <label class="flex items-center space-x-1">
      <input type="radio" name="topo_editor_mode" value="holds" data-action="topo-editor#setMode">
      <span>Start holds <span style="color:#10b981">&#9711;</span></span>
    </label>
    <label class="flex items-center space-x-1">
      <input type="radio" name="topo_editor_mode" value="excluded" data-action="topo-editor#setMode">
      <span>Not-in areas <span style="color:#dc2626">&#9638;</span></span>
    </label>
    <a href="#" class="text-emerald-600 font-semibold" data-action="topo-editor#clearHolds">Clear start holds</a>
    <a href="#" class="text-emerald-600 font-semibold" data-action="topo-editor#newExcludedArea">New not-in area</a>
    <a href="#" class="text-emerald-600 font-semibold" data-action="topo-editor#clearExcludedAreas">Clear not-in areas</a>
    <span class="flex items-center space-x-2">
      <span class="font-semibold">Zoom:</span>
      <a href="#" class="text-emerald-600 font-semibold px-1" data-action="topo-editor#zoomOut" aria-label="Zoom out">&minus;</a>
      <span class="tabular-nums" data-topo-editor-target="zoomLabel">1&times;</span>
      <a href="#" class="text-emerald-600 font-semibold px-1" data-action="topo-editor#zoomIn" aria-label="Zoom in">+</a>
    </span>
  </div>

  <%# Zooming enlarges the photo and canvas; this viewport scrolls to pan. The photo needs
      max-width:none, or Tailwind's img { max-width: 100% } shrinks it below the canvas when
      zoomed wider than the page and clicks land in the wrong place. %>
  <div style="overflow:auto; max-width:100%; max-height:80vh" data-topo-editor-target="viewport">
    <div style="position:relative" data-topo-editor-target="container">
      <%= cdn_image_tag(@line.topo.photo.variant(:medium), data: { "topo-editor-target": "image" }, style: "position:absolute;z-index:1;max-width:none;") %>
      <canvas data-topo-editor-target="canvas" data-action="click->topo-editor#createPoint" style="position:relative;z-index:20;"></canvas>
    </div>
  </div>

  <div class="my-3">
    <%= form_with model: [:admin, @line], data: { "topo-editor-target": "form" } do |form| %>
      <div class="my-3">
        <%= form.label :coordinates %>
        <%= form.text_area :coordinates, rows: "4", data: { "topo-editor-target": 'textarea' }, value: @line.coordinates.to_json %>
      </div>

      <div class="my-3">
        <%= form.label :start_holds, "Start holds (optional, up to #{Line::MAX_START_HOLDS})" %>
        <%= form.text_area :start_holds, rows: "2", data: { "topo-editor-target": 'holdsTextarea' }, value: @line.start_holds&.to_json %>
      </div>

      <div class="my-3">
        <%= form.label :excluded_areas, "Not-in areas (optional, up to #{Line::MAX_EXCLUDED_AREAS} shapes of 3+ points each)" %>
        <%= form.text_area :excluded_areas, rows: "3", data: { "topo-editor-target": 'excludedTextarea' }, value: @line.excluded_areas&.to_json %>
      </div>

      <div class="my-3">
        <%= form.submit "Save", class: "btn" %>
        <% items = [] %>
        <% items << { text: "destroy", link: admin_line_path(@line), data: { "turbo-confirm": 'Are you sure?', "turbo-method": :delete } } %>
        <%= render 'shared/dot_menu', items: items, align_class: "bottom-0" %>
      </div>
    <% end %>
  </div>
</div>

<div style="margin-bottom: 300px"></div>
