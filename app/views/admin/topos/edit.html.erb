<% add_breadcrumb "Dartmoor", admin_areas_path %>
<% if area = @topo.area_id && Area.find_by(id: @topo.area_id) %>
  <% add_breadcrumb area.name, admin_area_problems_path(area_slug: area.slug, circuit_id: "first") %>
<% end %>
<% add_breadcrumb "Topo ##{@topo.id}", nil, class: "active" %>

<% if area %>
  <p class="my-3"><%= link_to "Draw lines on this photo (workbench) →", workbench_admin_topo_path(@topo), class: "text-granite font-medium hover:underline" %></p>
<% end %>

<% if (newer = @topo.replaced_by_topo) %>
  <p class="my-3 max-w-md rounded bg-amber-50 border border-amber-200 px-3 py-2 text-sm">Replaced by <%= link_to "Topo ##{newer.id}", workbench_admin_topo_path(newer), class: "text-granite hover:underline" %>, so it's off the site. Undo the swap from <%= link_to "this photo's workbench", workbench_admin_topo_path(@topo), class: "text-granite hover:underline" %>.</p>
<% elsif (older = @topo.replaces_topo) %>
  <p class="my-3 max-w-md rounded bg-blue-50 border border-blue-200 px-3 py-2 text-sm">Replacing <%= link_to "Topo ##{older.id}", workbench_admin_topo_path(older), class: "text-granite hover:underline" %>: off the site until it's swapped in from <%= link_to "the workbench", workbench_admin_topo_path(@topo), class: "text-granite hover:underline" %>.</p>
<% end %>

<% if area %>
  <div class="my-3 max-w-md rounded border border-gray-200 bg-white p-3">
    <%= render "admin/topos/neighbours", topo: @topo %>
  </div>
<% end %>

<div class="my-3">
  <% @topo.problems.each do |problem| %>
    <span class="mr-3">
      <%= problem_circle_view_with_name(problem) %>
    </span>
  <% end %>
</div>

<div>
  <div>
    <%= image_tag(@topo.photo) %>
  </div>

  <%= form_with model: [:admin, @topo] do |form| %>
    <div class="form-group form-check mt-8">
      <%= form.check_box :published, class: "form-check-input" %>
      <%= form.label :published %>
    </div>

    <div class="form-group">
      <p class="my-8">
        <div>Metadata</div>
        <code>
          <pre>
            <%= JSON.pretty_generate(@topo.metadata) %>
          </pre>
        </code>
      </p>

      <div class="mt-8">
        <%= form.submit("Update", class: "btn btn-primary") %>
      </div>
    </div>
  <% end %>

  <div class="mt-4">
    <%= button_to "Delete topo", admin_topo_path(@topo),
          method: :delete,
          data: { turbo_confirm: "Delete this topo and all its lines? This cannot be undone." },
          class: "px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded transition-colors" %>
  </div>
</div>

<div style="margin-bottom: 300px"></div>
