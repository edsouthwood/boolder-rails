<% if current_admin_user.super_admin? %>
  <div class="my-4">
    <%= link_to "New area", new_admin_area_path, class: "btn" %>
  </div>
<% end %>

<div class="flex flex-col my-6">
  <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
      <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <%= link_to "Id", admin_areas_path(sort: :id) %>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <%= link_to "Name", admin_areas_path(sort: :name) %>
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Problems
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tools</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @areas.each do |area| %>
              <tr class="place-content-start align-top h-16">
                <td class="px-6 py-2 whitespace-nowrap w-1/12">
                  <div class="text-sm text-gray-500">
                    <%= link_to area.id, admin_area_problems_path(area_slug: area.slug, circuit_id: "first") %>
                  </div>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-4/12">
                  <span class="text-sm text-gray-900 font-bold">
                    <%= link_to area.name, admin_area_problems_path(area_slug: area.slug, circuit_id: "first") %>
                  </span>
                  <% if !area.published? %>
                    <div class="text-yellow-500 text-sm">not published</div>
                  <% end %>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-4/12">
                  <span class="text-sm text-gray-500"><%= area.problems.with_location.count %></span>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-3/12 text-sm">
                  <% counts = area_tool_counts(area, boulders: false) %>
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <%= link_to admin_area_boulders_path(area_slug: area.slug), class: "text-granite hover:underline" do %>Boulders<% end %>
                    <%= link_to admin_area_topos_path(area_slug: area.slug, undrawn: (1 if counts[:photos].positive?)), class: "text-granite hover:underline" do %>
                      Photos<% if counts[:photos].positive? %> <span class="rounded-full bg-amber-100 text-amber-800 px-1.5 text-xs font-semibold" title="<%= counts[:photos] %> to draw"><%= counts[:photos] %></span><% end %>
                    <% end %>
                    <%= link_to admin_area_map_editor_path(area_slug: area.slug), class: "text-granite hover:underline" do %>
                      Map<% if counts[:map].positive? %> <span class="rounded-full bg-amber-100 text-amber-800 px-1.5 text-xs font-semibold" title="<%= counts[:map] %> to place"><%= counts[:map] %></span><% end %>
                    <% end %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<p><%= "#{@areas.count} results" %></p>
