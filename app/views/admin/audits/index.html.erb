<h2 class="text-2xl font-bold pt-4 px-4 sm:px-0">Audit log</h2>

<%= form_with url: admin_audits_path, method: :get, class: "my-4 flex flex-wrap gap-4 px-4 sm:px-0", data: { controller: "auto-submit" } do |form| %>
  <div>
    <label for="user" class="block text-sm font-medium text-gray-700">Who</label>
    <%= form.select :user, @usernames + [ [ "No name (visitors, jobs, scripts)", Admin::AuditsController::NO_NAME ] ], { selected: @user, include_blank: "Everyone" }, { data: { action: "change->auto-submit#submit" }, class: "mt-1 block w-full md:w-56 rounded-md border-gray-300 py-2 pl-3 pr-10 text-base focus:border-granite focus:outline-none focus:ring-granite sm:text-sm" } %>
  </div>
  <div>
    <label for="type" class="block text-sm font-medium text-gray-700">What</label>
    <%= form.select :type, @types.map { |t| [ t.underscore.humanize, t ] }, { selected: @type, include_blank: "Everything" }, { data: { action: "change->auto-submit#submit" }, class: "mt-1 block w-full md:w-56 rounded-md border-gray-300 py-2 pl-3 pr-10 text-base focus:border-granite focus:outline-none focus:ring-granite sm:text-sm" } %>
  </div>
<% end %>

<% if @audits.empty? %>
  <p class="my-8 text-sm text-gray-500 italic px-4 sm:px-0">No changes match.</p>
<% else %>
<div class="flex flex-col my-6">
  <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
      <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Id</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Who</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">What</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Associated</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Changes</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Infos</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @audits.each do |audit| %>
              <tr class="place-content-start align-top h-16">
                <td class="px-6 py-2 whitespace-nowrap w-1/12">
                  <div class="text-sm text-gray-500"><%= audit.id %></div>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-1/12">
                  <div class="text-sm text-gray-500"><%= l(audit.created_at, format: :short) %></div>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-1/12">
                  <%= audit.username %>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-1/12">
                  <% if audit.auditable&.class&.name == "Line" %>
                    <div><%= problem_circle_view_with_name(audit.auditable.problem) %></div>
                  <% elsif audit.auditable&.class&.name == "Problem" %>
                    <div><%= problem_circle_view_with_name(audit.auditable) %></div>
                  <% else %>
                    <div class="text-gray-500"><%= audit_record_link(audit.auditable_type, audit.auditable_id, audit.auditable) %></div>
                  <% end %>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-1/12">
                  <%= audit_record_link(audit.associated_type, audit.associated_id, audit.associated) if audit.associated_id %>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-2/12">
                  <% klass = audit.action == "destroy" ? "text-red-500" : "" %>
                  <span class="<%= klass %>"><%= audit.action %></span>
                </td>
                <td class="px-6 py-2 whitespace-nowrap w-3/12">
                  <% if audit&.action == "update" %>
                    <table>
                      <tbody>
                        <% audit.audited_changes.each do |field, diff| %>
                          <tr style="background-color: transparent;">
                            <td><strong><%= field %></strong></td>
                            <td><%= word_diff_html(diff.second.to_s, diff.first.to_s) %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="my-4 flex flex-wrap items-center justify-between gap-3 px-4 sm:px-0">
  <p class="text-sm text-gray-600"><%= page_entries_info @audits, entry_name: "change" %></p>
  <%= paginate @audits %>
</div>
<% end %>
