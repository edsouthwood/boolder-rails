<% content_for :head do %>
  <link href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" rel="stylesheet">
  <%= render "shared/maplibre_script" %>
<% end %>

<% add_breadcrumb "Dartmoor", admin_areas_path %>
<% add_breadcrumb @area.name, admin_area_problems_path(area_slug: @area.slug) %>
<% add_breadcrumb "Boulder Editor", nil, class: "active" %>
<% area_toolbar @area, :outlines %>

<div
  data-controller="admin-boulder-editor"
  data-admin-boulder-editor-geojson-url-value="<%= geojson_source_url(@area) %>"
  data-admin-boulder-editor-create-url-value="<%= admin_area_boulders_path(area_slug: @area.slug) %>"
  data-admin-boulder-editor-update-url-template-value="<%= admin_boulder_path('BOULDER_ID') %>"
  data-admin-boulder-editor-delete-url-template-value="<%= admin_boulder_path('BOULDER_ID') %>"
  data-admin-boulder-editor-visibility-url-template-value="<%= visibility_admin_boulder_path('BOULDER_ID') %>"
  data-admin-boulder-editor-bounds-value="<%= @area.serialized_bounds.to_json %>"
  data-admin-boulder-editor-maptiler-key-value="<%= @maptiler_key %>"
  data-admin-boulder-editor-azure-key-value="<%= @azure_maps_key %>"
  data-admin-boulder-editor-mapbox-key-value="<%= @mapbox_key %>"
  data-admin-boulder-editor-unplaced-value="<%= @unplaced.to_json %>"
  <% if @focus_id %>data-admin-boulder-editor-focus-id-value="<%= @focus_id %>"<% end %>
  <% if @place_id %>data-admin-boulder-editor-place-id-value="<%= @place_id %>"<% end %>
>
  <%# Side by side from md up; on phones the sidebar sits above the map so the map gets the full width %>
  <div class="flex flex-col md:flex-row border rounded overflow-hidden bg-white shadow" style="height: calc(100vh - 15rem)">

    <%# Sidebar %>
    <div class="w-full md:w-64 max-h-[45%] md:max-h-none flex-shrink-0 flex flex-col border-b md:border-b-0 md:border-r overflow-y-auto md:overflow-hidden bg-gray-50">

      <div class="px-3 py-2 bg-gray-800 text-white text-sm font-semibold flex-shrink-0">
        <%= @area.name %> — Boulder Editor
      </div>

      <%# Tool buttons %>
      <div class="p-3 border-b flex flex-col gap-2 flex-shrink-0">
        <button
          data-action="click->admin-boulder-editor#startDrawing"
          data-admin-boulder-editor-target="drawBtn"
          class="w-full px-3 py-2 text-sm font-medium rounded bg-granite text-white hover:bg-granite-dark transition-colors"
        >
          + Draw boulder
        </button>

        <button
          data-action="click->admin-boulder-editor#toggleProblems"
          data-admin-boulder-editor-target="toggleProblemsBtn"
          class="w-full px-3 py-2 text-sm font-medium rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition-colors"
        >
          Show problems
        </button>

        <div data-admin-boulder-editor-target="selectedActions" class="hidden flex flex-col gap-2">
          <label class="block text-xs font-medium text-gray-600">
            Name
            <span class="flex gap-1 mt-0.5">
              <input type="text" autocomplete="off" placeholder="No name"
                     data-admin-boulder-editor-target="nameInput"
                     data-action="keydown.enter->admin-boulder-editor#saveName input->admin-boulder-editor#renderNameOptions"
                     class="flex-1 min-w-0 px-2 py-1 text-sm rounded border border-gray-300 focus:border-granite focus:ring-granite">
              <button type="button" data-action="click->admin-boulder-editor#saveName"
                      class="px-2 py-1 text-xs rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100">Set</button>
            </span>
          </label>
          <div data-admin-boulder-editor-target="nameOptionsBox" class="hidden -mt-1">
            <p class="text-xs text-gray-500 mb-1">Names from your problem list (click one to give this outline its problems):</p>
            <div data-admin-boulder-editor-target="nameOptions" class="max-h-40 overflow-y-auto rounded border border-gray-200 bg-white divide-y divide-gray-100"></div>
          </div>
          <button
            data-action="click->admin-boulder-editor#useLidarOutline"
            data-admin-boulder-editor-target="useLidarBtn"
            class="hidden w-full px-3 py-2 text-sm font-medium rounded border border-green-600 bg-white text-green-700 hover:bg-green-50 transition-colors"
          >
            Use LiDAR outline
          </button>
          <p data-admin-boulder-editor-target="hiddenNote" class="hidden text-xs px-2 py-1 rounded bg-amber-50 text-amber-800">
            Hidden: this outline and its problems are off the public site.
          </p>
          <div class="flex flex-col gap-1">
            <p class="text-xs text-gray-500">Drag a corner to move it. Drag or click a faint dot to add a corner. Click a corner, then <strong>Remove point</strong> (or Alt-click it).</p>
            <button
              data-action="click->admin-boulder-editor#removePickedPoint"
              data-admin-boulder-editor-target="removePointBtn"
              disabled
              class="w-full px-3 py-1.5 text-sm font-medium rounded border border-red-300 bg-white text-red-700 hover:bg-red-50 disabled:opacity-40 disabled:hover:bg-white disabled:cursor-not-allowed transition-colors"
            >
              Remove point
            </button>
          </div>
          <button
            data-action="click->admin-boulder-editor#saveSelected"
            class="w-full px-3 py-2 text-sm font-medium rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors"
          >
            Save changes
          </button>
          <button
            data-action="click->admin-boulder-editor#toggleHidden"
            data-admin-boulder-editor-target="hideBtn"
            title="Keeps the outline and its problems, but leaves them off the public map, area pages and search until you bring it back"
            class="w-full px-3 py-2 text-sm font-medium rounded border border-amber-500 bg-white text-amber-700 hover:bg-amber-50 transition-colors"
          >
            Hide boulder from the public site
          </button>
          <button
            data-action="click->admin-boulder-editor#deleteSelected"
            class="w-full px-3 py-2 text-sm font-medium rounded bg-red-600 text-white hover:bg-red-700 transition-colors"
          >
            Delete boulder
          </button>
        </div>

        <div data-admin-boulder-editor-target="drawingActions" class="hidden flex flex-col gap-2">
          <p class="text-xs text-gray-600 text-center">Click to add vertices.<br>Double-click to finish.</p>
          <button
            data-action="click->admin-boulder-editor#cancelDrawing"
            class="w-full px-3 py-2 text-sm font-medium rounded bg-gray-200 text-gray-700 hover:bg-gray-300 transition-colors"
          >
            Cancel (Esc)
          </button>
        </div>
      </div>

      <%# Status %>
      <div class="px-3 py-2 text-xs text-gray-500 border-b flex-shrink-0">
        <span data-admin-boulder-editor-target="count"><%= @boulder_count %></span> boulder<span data-admin-boulder-editor-target="countSuffix"><%= @boulder_count == 1 ? '' : 's' %></span>
        &nbsp;·&nbsp;
        <span data-admin-boulder-editor-target="status">Click a polygon to select</span>
      </div>

      <%# Instructions %>
      <div class="px-3 py-3 text-xs text-gray-500 flex-shrink-0 border-b">
        <p class="font-medium text-gray-700 mb-1">How to use</p>
        <ul class="space-y-1 list-disc list-inside">
          <li>Zoom in on satellite image</li>
          <li>Click <strong>Draw boulder</strong> to trace a new outline</li>
          <li>Click an existing boulder to select and edit its corners</li>
          <li>Drag corners to reshape; drag or click a faint mid-edge dot to add one</li>
          <li>Click a corner, then <strong>Remove point</strong> (or Delete) to remove it</li>
          <li>While drawing, Delete/Backspace takes back the last point</li>
        </ul>
      </div>

      <%# Basemap switcher %>
      <div class="px-3 py-2 border-b flex-shrink-0">
        <p class="text-xs font-medium text-gray-600 mb-1.5">Basemap</p>
        <div class="flex gap-1 flex-wrap">
          <button data-action="click->admin-boulder-editor#setBasemap"
                  data-basemap="esri"
                  data-admin-boulder-editor-target="basemapBtn"
                  class="px-2 py-1 text-xs rounded border transition-colors">
            ESRI
          </button>
          <% if @maptiler_key.present? %>
            <button data-action="click->admin-boulder-editor#setBasemap"
                    data-basemap="maptiler"
                    data-admin-boulder-editor-target="basemapBtn"
                    class="px-2 py-1 text-xs rounded border transition-colors">
              MapTiler
            </button>
          <% end %>
          <% if @azure_maps_key.present? %>
            <button data-action="click->admin-boulder-editor#setBasemap"
                    data-basemap="bing"
                    data-admin-boulder-editor-target="basemapBtn"
                    class="px-2 py-1 text-xs rounded border transition-colors">
              Bing
            </button>
          <% end %>
          <% if @mapbox_key.present? %>
            <button data-action="click->admin-boulder-editor#setBasemap"
                    data-basemap="mapbox"
                    data-admin-boulder-editor-target="basemapBtn"
                    class="px-2 py-1 text-xs rounded border transition-colors">
              Mapbox
            </button>
          <% end %>
        </div>
      </div>

      <%# Devon County Council aerials: a link out only. Their terms allow viewing on their site, not copying or screenshots %>
      <div class="px-3 py-2 border-b flex-shrink-0">
        <p class="text-xs font-medium text-gray-600 mb-1.5">Council aerials</p>
        <button data-action="click->admin-boulder-editor#openCouncilAerials"
                class="w-full px-2 py-1 text-xs rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition-colors">
          Open DCC aerial view here ↗
        </button>
        <p class="mt-1 text-xs text-gray-400">Opens Devon County Council's viewer in a new tab at this spot (or the selected boulder). Pick the aerial basemap in its gallery. Look only: no screenshots or copies.</p>
      </div>

      <%# LiDAR overlay %>
      <div class="px-3 py-2 border-b flex-shrink-0">
        <p class="text-xs font-medium text-gray-600 mb-1.5">LiDAR</p>
        <div class="flex items-center gap-2">
          <button data-action="click->admin-boulder-editor#toggleLidar"
                  data-admin-boulder-editor-target="lidarBtn"
                  class="px-2 py-1 text-xs rounded border transition-colors">
            LiDAR off
          </button>
          <input type="range" min="0" max="100" value="60"
                 aria-label="LiDAR opacity"
                 data-action="input->admin-boulder-editor#setLidarOpacity"
                 data-admin-boulder-editor-target="lidarOpacity"
                 class="flex-1 min-w-0 accent-gray-800 disabled:opacity-40">
        </div>
        <p class="mt-1 text-xs text-gray-400">Shows rock as relief, without shadows. Slide to blend with the satellite image.</p>
        <button data-action="click->admin-boulder-editor#suggestBoulders"
                data-admin-boulder-editor-target="suggestBtn"
                class="mt-2 w-full px-2 py-1 text-xs rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 disabled:opacity-50 transition-colors">
          Suggest boulders in this view
        </button>
        <p data-admin-boulder-editor-target="suggestStatus" class="mt-1 text-xs text-gray-500" aria-live="polite"></p>
        <button data-action="click->admin-boulder-editor#addAllUnmapped"
                data-admin-boulder-editor-target="addAllBtn"
                class="hidden mt-1 w-full px-2 py-1 text-xs rounded bg-granite text-white hover:bg-granite-dark disabled:opacity-50 transition-colors">
          Add all unmapped as boulders
        </button>
      </div>

      <%# Tracing image: stays in this browser, never uploaded %>
      <div class="px-3 py-2 border-b flex-shrink-0">
        <p class="text-xs font-medium text-gray-600 mb-1.5">Tracing image</p>
        <input type="file" accept="image/jpeg,image/png,image/webp" class="hidden"
               data-admin-boulder-editor-target="imageInput"
               data-action="change->admin-boulder-editor#loadOverlayImage">
        <button data-action="click->admin-boulder-editor#chooseOverlayImage"
                data-admin-boulder-editor-target="imageChooseBtn"
                class="w-full px-2 py-1 text-xs rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition-colors">
          Import image…
        </button>
        <div data-admin-boulder-editor-target="imageControls" class="hidden mt-2 flex flex-col gap-2">
          <input type="range" min="0" max="100" value="60"
                 aria-label="Tracing image opacity"
                 data-action="input->admin-boulder-editor#setOverlayOpacity"
                 data-admin-boulder-editor-target="imageOpacity"
                 class="w-full accent-gray-800">
          <div class="flex gap-1">
            <button data-action="click->admin-boulder-editor#toggleOverlayAdjust"
                    data-admin-boulder-editor-target="imageAdjustBtn"
                    class="flex-1 px-2 py-1 text-xs rounded border transition-colors">
              Move / resize
            </button>
            <button data-action="click->admin-boulder-editor#removeOverlayImage"
                    class="px-2 py-1 text-xs rounded border border-red-300 bg-white text-red-700 hover:bg-red-50 transition-colors">
              Remove
            </button>
          </div>
        </div>
        <p class="mt-1 text-xs text-gray-400">A JPEG or PNG laid over the map to trace from. Only on this computer: never uploaded, gone when you reload. Use images you have the rights to (your own drone or phone photos, open-licence maps).</p>
      </div>

      <%# Listed names without an outline yet %>
      <div data-admin-boulder-editor-target="unplacedSection" class="hidden px-3 py-2 border-b flex-shrink-0">
        <p class="text-xs font-medium text-gray-600 mb-1">Not on the map yet</p>
        <p class="text-xs text-gray-400 mb-1">Click a name, then draw its outline.</p>
        <div data-admin-boulder-editor-target="unplacedList" class="text-xs max-h-40 overflow-y-auto"></div>
      </div>

      <div class="flex-1 overflow-y-auto">
        <div data-admin-boulder-editor-target="boulderList" class="divide-y text-xs text-gray-500 px-3 py-2">
          <p class="italic text-gray-400">Loading boulders…</p>
        </div>
      </div>
    </div>

    <%# Map %>
    <div
      class="flex-1 min-h-0 relative"
      id="boulder-editor-canvas"
      data-admin-boulder-editor-target="mapContainer"
    >
      <%# MapLibre renders here %>
    </div>

  </div>

  <p data-admin-boulder-editor-target="attribution" class="mt-2 text-xs text-gray-400">
    Satellite imagery © Esri. Boulder data saves automatically on finish.
  </p>
</div>
