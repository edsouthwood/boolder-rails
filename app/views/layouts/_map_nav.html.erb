<nav class="bg-white border-b border-line">
  <div class="max-w-site mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center gap-4 h-[68px]">
      <div class="flex px-2 lg:px-0">
        
        <div class="flex-shrink-0 flex items-center">
          <% if params[:contribute] %>
            <% url = if @problem && @problem[:id]
                  mapping_problem_path(id: @problem[:id])
                elsif @area
                  mapping_problems_path(area_id: @area.id)
                else
                  mapping_path
                end
             %>
            <%= link_to url do %>
              <div class="flex items-center justify-center min-h-[44px] min-w-[44px] text-sm font-medium text-muted hover:text-granite">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
              </div>
            <% end %>
          <% else %>
            <%= render "layouts/brand" %>
          <% end %>
        </div>
        
      </div>

      <div class="flex items-center gap-1 flex-1 justify-end">
        <%# Section links on wider screens only: phones keep the full width for search. %>
        <div class="hidden lg:flex items-center gap-1">
          <%= link_to t("views.layout.nav.discover"), areas_path, class: nav_link_classes(active: false) %>
          <%= link_to t("views.layout.nav.map"), map_path, class: nav_link_classes(active: true) %>
          <%= link_to t("views.layout.footer.contribute"), contribute_path, class: nav_link_classes(active: false) %>
        </div>
        <%= render 'shared/search_modal', show_button: false %>
      </div>
    </div>
  </div>

</nav>