<%# Installable-app (PWA) tags, shared by application.html.erb and map.html.erb. %>
<link rel="manifest" href="/manifest">
<meta name="theme-color" content="#33393D">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Dartmoor">
<%= javascript_tag nonce: true do %>
  // Register on every page (a shared map link may be someone's first visit), so
  // the offline cache and install support are ready wherever they land.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/service-worker.js', { scope: '/' })
  }
  // Chrome fires beforeinstallprompt once, often before Stimulus has connected, so
  // stash it for install_prompt_controller.js and tell any connected controller.
  window.addEventListener('beforeinstallprompt', function(event) {
    event.preventDefault()
    window.deferredInstallPrompt = event
    window.dispatchEvent(new Event('installprompt-available'))
  })
<% end %>
