<footer class="bg-granite text-on-dark">
  <div class="max-w-site mx-auto px-6 py-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
    <%= link_to root_localized_path, class: "flex items-center gap-2 min-h-[44px]" do %>
      <%= bowda_logo_svg(color: "#C9CDD0", width: 26, height: 30) %>
      <span class="text-[22px] font-extrabold tracking-[-0.04em] text-white">bowda</span>
    <% end %>

    <nav class="flex flex-wrap -mx-3" aria-label="Footer">
      <% link_class = "flex items-center min-h-[44px] px-3 text-on-dark hover:text-white hover:underline" %>
      <a href="<%= about_path %>" class="<%= link_class %>"><%= t('views.layout.footer.about') %></a>
      <a href="<%= contribute_path %>" class="<%= link_class %>"><%= t('views.layout.footer.contribute') %></a>
      <a href="<%= downloads_path %>" class="<%= link_class %>">Offline downloads</a>
      <a href="<%= privacy_path %>" class="<%= link_class %>"><%= t('views.layout.footer.privacy') %></a>

      <%# Hidden in production until the contributors have agreed the CC0 license. %>
      <% if Rails.env.local? %>
        <a href="<%= about_path(anchor: "open-data") %>" class="<%= link_class %>"><%= t('views.layout.footer.open_data') %></a>
      <% end %>
    </nav>
  </div>
</footer>
