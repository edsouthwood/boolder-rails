<nav class="bg-white border-b border-line">
  <div class="max-w-site mx-auto px-6 py-3.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <%= render "layouts/brand" %>

    <div class="flex items-center gap-1 -mx-3.5 sm:mx-0">
      <%= link_to areas_path, class: nav_link_classes(active: controller_name.in?(%w[areas problems circuits])) do %>
        <%= t("views.layout.nav.discover") %>
      <% end %>

      <%= link_to map_path, class: nav_link_classes(active: controller_name == "map") do %>
        <%= t("views.layout.nav.map") %>
      <% end %>

      <%= link_to contribute_path, class: nav_link_classes(active: action_name == "contribute" || controller_path.start_with?("mapping")) do %>
        <%= t("views.layout.footer.contribute") %>
      <% end %>

      <%= render 'shared/search_modal', show_button: true %>
    </div>
  </div>
</nav>
