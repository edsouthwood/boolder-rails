<% # Don't forget to update application.html.erb too %>
<!doctype html>
<% # Trick to make the page full height even on mobile: https://stackoverflow.com/a/24979148 %>
<html lang="<%= I18n.locale %>" class="h-full m-0">
  <head>
    <%= render "layouts/icons" %>
    <%= render "layouts/pwa_head" %>

    <%= display_meta_tags site: 'Dartmoor Bouldering', reverse: true %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/bugsnag" %>

    <%= stylesheet_link_tag "tailwind", "outfit-font", "data-turbo-track": "reload" %>
    <%= preload_link_tag "outfit-latin.woff2" %>

    <script async src="https://ga.jspm.io/npm:es-module-shims@1.8.2/dist/es-module-shims.js" data-turbo-track="reload"></script>
    <%= javascript_importmap_tags %>


    <link href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" rel="stylesheet">
    <%# defer keeps parsing unblocked. Do NOT rely on this running before the importmap
        modules: es-module-shims loads async and a warm HTTP cache changes the
        interleaving, so the Stimulus controller intermittently connected with
        maplibregl still undefined (blank map). The 'maplibre-ready' event is the contract —
        mapbox_controller waits for it, as the admin/mapping map controllers already do. %>
    <%= render "shared/maplibre_script", defer: true %>
    <style>
      #map { position: absolute; top: 0; bottom: 0; width: 100%; }
    </style>

    <meta name="turbo-visit-control" content="reload">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body class="bg-white h-full m-0">
    <div class="bg-ground flex flex-col h-full">
      <div class="flex-initial">
        <%= render "layouts/map_nav" %>
      </div>
      <%= yield %>
    </body>
  </div>
</html>
