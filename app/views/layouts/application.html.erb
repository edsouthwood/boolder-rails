<% # Don't forget to update map.html.erb too %>
<!doctype html>
<html lang="<%= I18n.locale %>">
  <head>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= render "layouts/pwa_head" %>

    <%= display_meta_tags site: 'Dartmoor Bouldering', reverse: true %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/bugsnag" %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    
    <script async src="https://ga.jspm.io/npm:es-module-shims@1.8.2/dist/es-module-shims.js" data-turbo-track="reload"></script>
    <%= javascript_importmap_tags %>
    

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= yield :json_ld %>
    <%= yield :head %>

    <script>
      // This code uses custom events coming from search_controller.js
      // FIXME: make code more robust
      let locale = "<%= I18n.locale %>";
      // Results carry their page path (no redirect hop, so saved pages open offline).
      window.addEventListener('gotoproblem', function(event) {
        window.location = event.detail.path || `/${locale}/redirects/new?problem_id=${event.detail.id}`
      });
      window.addEventListener('gotoarea', function(event) {
        window.location = event.detail.path || `/${locale}/redirects/new?area_id=${event.detail.id}`
      });
    </script>
  </head>

  <body class="bg-white">

    <div class="bg-gray-100">
      <%= render "layouts/nav" unless @hide_nav %>
      <%= render "layouts/flash" %>
      <%= yield %>
      <%= render "layouts/footer" unless @hide_nav %>
    </body>
  </div>
</html>
