<% set_meta_tags title: t("views.problems.index.metas.title", grade: @grade) %>
<% set_meta_tags og: { type: "website", image: image_url("hero-homepage.jpg") } %>

<div class="max-w-7xl mx-auto pt-6 sm:px-6 lg:px-8">
  <div class="px-4 sm:px-0">
    <div class="flex items-center space-x-1 text-sm font-medium text-gray-500">
      <div><%= link_to "Dartmoor", areas_path, class: "hover:text-gray-700" %></div>
    </div>
  </div>
</div>

<div class="max-w-7xl mx-auto sm:px-6 lg:px-8 mb-8">
  <h1 class="text-3xl font-bold mt-2 mb-4 px-4 sm:px-0">Problems by grade</h1>

  <div class="max-w-3xl">
    <%= form_with url: problems_path, method: :get, class: "px-4 sm:px-0" do |form| %>
      <label for="grade" class="block text-sm font-medium text-gray-700">Grade</label>
      <%= form.select :grade, @grades.map { |grade, count| [ "#{grade} (#{count})", grade ] }, { selected: @grade },
            { onchange: "this.form.submit()", class: "mt-1 block w-full md:w-1/3 rounded-md border-gray-300 py-2 pl-3 pr-10 text-base focus:border-granite focus:outline-none focus:ring-granite sm:text-sm" } %>
    <% end %>

    <p class="mt-6 mb-2 px-4 sm:px-0 text-sm text-gray-500">
      <%= pluralize(@problems.size, "problem") %> at <%= @grade %> across Dartmoor. Those with a topo photo come first.
    </p>

    <ul role="list">
      <% @problems.each do |problem| %>
        <li class="px-4 sm:-mx-2 sm:px-2 hover:bg-gray-50 rounded-lg">
          <%= link_to problem_friendly_path(problem) do %>
            <div class="flex justify-between gap-4 py-2">
              <div class="min-w-0">
                <%= problem_circle_view(problem) %>
                <span class="ml-2"><%= problem.name_with_fallback %></span>
                <span class="ml-2 text-gray-500"><%= problem.grade %></span>
                <% if problem.has_line %>
                  <span class="ml-2 text-xs text-gray-400">topo</span>
                <% end %>
              </div>
              <div class="text-gray-400 text-right shrink-0"><%= problem.area.name %></div>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
