<%# Sent to whatever address was typed in, before any review, so it must not echo the
    submitter's free text (name, comment): that would let anyone send their own message
    to a stranger from our address. %>
<p><%= t("contribute_mailer.greeting", name: t("contribute_mailer.fallback_name")) %></p>

<p><%= t("photo_contribution_mailer.acknowledgement_email.body", area: @photo_contribution.area.name) %></p>

<p><%= t("contribute_mailer.signoff") %></p>
