<div class="relative" data-controller="topo-line" data-action="turbo:before-cache@window->topo-line#hidePath" data-topo-line-coordinates-value="<%= line.coordinates.to_json %>" data-topo-line-color-value="<%= grade_color(line.problem.grade) %>">
  <%= render 'shared/topo_image', topo: line.topo, klass: "sm:rounded-lg" %>

  <% 
    # README
    # please be careful about z-index when changing this partial
    # a few rules of thumb:
    # - shadows must not be on top of any lines or circles
    # - the main line should always be on top of everything
    # - circuits should probably take precendence when possible

    # example of complex overlapping: 
    # /fr/fontainebleau/cuvier/448-le-surplomb-du-reveil-matin
  %>


  <% if line.excluded_areas.present? %>
    <%# "Not in" areas sit underneath everything else (lines, circles, holds) %>
    <div class="absolute top-0 left-0 w-full pointer-events-none hidden" data-topo-line-target="circle">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" aria-label="<%= t("problem.not_in") %>">
        <defs>
          <pattern id="not-in-hatch-<%= line.id %>" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="8" stroke="#dc2626" stroke-width="3" stroke-opacity="0.7" />
          </pattern>
        </defs>
        <% line.excluded_areas.each do |area| %>
          <polygon points="<%= area.map { |p| "#{(p['x'] * 400).round(1)},#{(p['y'] * 300).round(1)}" }.join(" ") %>"
                   fill="url(#not-in-hatch-<%= line.id %>)" stroke="#dc2626" stroke-width="1.5" stroke-dasharray="4 3" stroke-linejoin="round" />
        <% end %>
      </svg>
    </div>
  <% end %>

  <% if line.coordinates %>
    <div class="absolute" style="left:<%= line.coordinates.first['x']*100 %>%; top:<%= line.coordinates.first['y']*100 %>%">
      <div class="absolute hidden" style="top:-12px; left:-12px;" data-topo-line-target="circle">
        <%= circle_view("&nbsp;".html_safe, klass: "h-6 w-6 leading-6 bg-gray-500 topo-line-shadow") %>
      </div>
    </div>
    <div class="absolute top-0 left-0 w-full pointer-events-none">
      <svg data-topo-line-target="svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" class="topo-line-shadow"></svg>
    </div>
  <% end %>

  <% line.secondary_lines.each do |secondary_line| %>
    <% if secondary_line.coordinates %>
      <div class="absolute" style="left:<%= secondary_line.coordinates.first['x']*100 %>%; top:<%= secondary_line.coordinates.first['y']*100 %>%">
        <div class="relative">
          <div class="absolute hidden z-0" style="top:-12px; left:-12px;" data-topo-line-target="circle">
            <%= circle_view("&nbsp;".html_safe, klass: "h-6 w-6 leading-6 bg-gray-500 topo-line-shadow") %>
          </div>
          <% move_on_top = (secondary_line.id != line.id) && secondary_line.problem.circuit_number.present? %>
          <div class="absolute hidden <%= move_on_top ? "z-10" : "z-0" %>" style="top:-12px; left:-12px;" data-topo-line-target="circle">
            <% path = (scope == :admin) ? admin_problem_path(secondary_line.problem) : problem_friendly_path(secondary_line.problem) %>
            <%= link_to path do %>
              <%= problem_circle_view(secondary_line.problem) %>
            <% end %>
          </div>
          
        </div>
      </div>
    <% end %>
  <% end %>

  <% if line.start_holds.present? %>
    <% hold_color = grade_outline_color(line.problem.grade) || grade_color(line.problem.grade) %>
    <% line.start_holds.each do |hold| %>
      <div class="absolute z-10" style="left:<%= hold['x']*100 %>%; top:<%= hold['y']*100 %>%">
        <div class="absolute hidden topo-line-shadow" style="top:-9px; left:-9px;" data-topo-line-target="circle">
          <div class="rounded-full" style="width:18px; height:18px; border:2px solid white; box-shadow:0 0 0 2px <%= hold_color %>, inset 0 0 0 2px <%= hold_color %>;" title="<%= t("problem.start_hold") %>"></div>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if line.coordinates %>
    <div class="absolute z-20" style="left:<%= line.coordinates.first['x']*100 %>%; top:<%= line.coordinates.first['y']*100 %>%">
      <div class="absolute hidden" style="top:-12px; left:-12px;" data-topo-line-target="circle">
        <%= grade_circle_view(line.problem.grade, klass: "h-6 w-6 leading-6 topo-line-shadow") %>
      </div>
    </div>
  <% end %>
</div>