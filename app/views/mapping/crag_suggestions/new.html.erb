<% set_meta_tags nofollow: true %>
<% set_meta_tags title: t("views.mapping.crag_suggestions.new.metas.title") %>
<% input_class = "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-granite sm:text-sm sm:leading-6" %>
<% label_class = "block text-sm font-medium leading-6 text-gray-900" %>
<% bounds = { south_west: { lat: Area::DEFAULT_BOUNDS[:south_west][:lat], lng: Area::DEFAULT_BOUNDS[:south_west][:lon] },
              north_east: { lat: Area::DEFAULT_BOUNDS[:north_east][:lat], lng: Area::DEFAULT_BOUNDS[:north_east][:lon] } } %>

<% content_for :head do %>
  <link href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" rel="stylesheet">
  <%= render "shared/maplibre_script" %>
<% end %>

<div class="max-w-7xl mx-auto pt-6 sm:px-6 lg:px-8">
  <div class="px-4 sm:px-0">
    <%= link_to mapping_path, class: "hover:text-gray-700" do %>
      <div class="flex items-center space-x-2 text-sm font-medium text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span><%= t("views.breadcrumbs.back") %></span>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-7xl mx-auto sm:px-6 lg:px-8 pb-12">
  <div class="px-4 sm:px-0 max-w-3xl">
    <h1 class="text-3xl font-bold mb-3 mt-2"><%= t("views.mapping.crag_suggestions.new.title") %></h1>
    <p class="text-base text-gray-600"><%= t("views.mapping.crag_suggestions.new.intro") %></p>
  </div>

  <div class="mt-8 max-w-3xl">
    <% if @crag_suggestion.errors.any? %>
      <div class="mb-4 rounded-md bg-red-50 p-4">
        <ul role="list" class="list-disc space-y-1 pl-5 text-sm text-red-700">
          <% @crag_suggestion.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [ :mapping, @crag_suggestion ], class: "space-y-8" do |form| %>
      <%= invisible_captcha %>

      <section class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
        <%= form.label :name, t("views.mapping.crag_suggestions.new.name_label"), class: label_class %>
        <%= form.text_field :name, required: true, maxlength: 100, class: "mt-2 #{input_class}" %>
        <p class="mt-1.5 text-xs text-gray-500"><%= t("views.mapping.crag_suggestions.new.name_hint") %></p>
      </section>

      <section class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8"
               data-controller="location-picker" data-location-picker-bounds-value="<%= bounds.to_json %>">
        <h2 class="text-base font-semibold leading-7 text-gray-900"><%= t("views.mapping.crag_suggestions.new.location_step") %></h2>
        <p class="mt-1 text-sm text-gray-600"><%= t("views.mapping.crag_suggestions.new.location_hint") %></p>
        <div data-location-picker-target="map" class="mt-4 w-full h-80 rounded-lg border border-gray-200 bg-ground"></div>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <%= form.label :location_lat, t("views.mapping.crag_suggestions.new.lat_label"), class: label_class %>
            <%= form.text_field :location_lat, required: true, inputmode: "decimal", placeholder: "50.123456",
                  value: @crag_suggestion.location_lat || @crag_suggestion.location&.lat,
                  data: { "location-picker-target": "latField" }, class: "mt-2 #{input_class}" %>
          </div>
          <div>
            <%= form.label :location_lon, t("views.mapping.crag_suggestions.new.lon_label"), class: label_class %>
            <%= form.text_field :location_lon, required: true, inputmode: "decimal", placeholder: "-3.123456",
                  value: @crag_suggestion.location_lon || @crag_suggestion.location&.lon,
                  data: { "location-picker-target": "lonField" }, class: "mt-2 #{input_class}" %>
          </div>
        </div>
      </section>

      <section class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
        <%= form.label :access_notes, t("views.mapping.crag_suggestions.new.access_label"), class: label_class %>
        <%= form.text_area :access_notes, rows: 4, maxlength: 2000,
              placeholder: t("views.mapping.crag_suggestions.new.access_placeholder"), class: "mt-2 #{input_class}" %>
      </section>

      <section class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
        <h2 class="text-base font-semibold leading-7 text-gray-900"><%= t("views.mapping.crag_suggestions.new.about_step") %></h2>
        <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= form.label :contributor_name, t("views.mapping.crag_suggestions.new.name_you_label"), class: label_class %>
            <%= form.text_field :contributor_name, maxlength: 100, autocomplete: "name", class: "mt-2 #{input_class}" %>
          </div>
          <div>
            <%= form.label :contributor_email, t("views.mapping.crag_suggestions.new.email_label"), class: label_class %>
            <%= form.email_field :contributor_email, autocomplete: "email", class: "mt-2 #{input_class}" %>
            <p class="mt-1.5 text-xs text-gray-500"><%= t("views.mapping.crag_suggestions.new.email_hint") %></p>
          </div>
        </div>
      </section>

      <div class="px-4 sm:px-0 flex justify-end">
        <%= form.submit t("views.mapping.crag_suggestions.new.submit"),
              class: "flex w-full sm:w-64 justify-center rounded-md bg-granite px-3 py-2 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-granite-dark cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
