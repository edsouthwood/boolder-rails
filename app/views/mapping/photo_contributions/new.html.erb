<% set_meta_tags nofollow: true %>
<% set_meta_tags title: t("views.mapping.photo_contributions.new.metas.title") %>
<% input_class = "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-granite sm:text-sm sm:leading-6" %>

<div class="max-w-7xl mx-auto pt-6 sm:px-6 lg:px-8">
  <div class="px-4 sm:px-0">
    <%= link_to mapping_path, class: "hover:text-gray-700" do %>
      <div class="flex items-center space-x-2 text-sm font-medium text-gray-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span><%= t("views.breadcrumbs.back") %></span>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-7xl mx-auto sm:px-6 lg:px-8 pb-12">
  <div class="px-4 sm:px-0 max-w-3xl">
    <h1 class="text-3xl font-bold mb-3 mt-2"><%= t("views.mapping.photo_contributions.new.title") %></h1>
    <p class="text-base text-gray-600"><%= t("views.mapping.photo_contributions.new.intro") %></p>
  </div>

  <div class="mt-8 max-w-3xl">
    <div class="space-y-8">

      <%# Step 1: the area. A plain GET form, so the "still needing photos" list can load. %>
      <section class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
        <h2 class="text-base font-semibold leading-7 text-gray-900"><%= t("views.mapping.photo_contributions.new.area_step") %></h2>
        <%= form_with url: new_mapping_photo_contribution_path, method: :get, class: "mt-3", data: { controller: "auto-submit" } do |form| %>
          <%= form.select :area_id, options_from_collection_for_select(@areas, :id, :name, @area&.id),
                { include_blank: t("views.mapping.photo_contributions.new.area_prompt") },
                { class: input_class, "aria-label": t("views.mapping.photo_contributions.new.area_step"),
                  data: { action: "change->auto-submit#submit" } } %>
          <noscript><%= form.submit t("views.mapping.photo_contributions.new.area_go"), class: "mt-2 text-sm underline" %></noscript>
        <% end %>
        <p class="mt-2 text-sm text-gray-500"><%= t("views.mapping.photo_contributions.new.area_hint") %></p>
      </section>

      <% if @area %>
        <%= form_with model: @photo_contribution, url: mapping_photo_contributions_path, class: "space-y-8",
              data: {
                controller: "photo-contribution",
                action: "submit->photo-contribution#send",
                photo_contribution_max_size_value: PhotoContribution::MAX_SIZE,
                photo_contribution_types_value: PhotoContribution::CONTENT_TYPES.to_json,
                photo_contribution_messages_value: t("views.mapping.photo_contributions.js").to_json
              } do |form| %>
          <%= invisible_captcha %>
          <%= form.hidden_field :area_id, value: @area.id %>

          <%# Step 2: which boulder. Required, so photos are never sent without an answer. %>
          <fieldset data-photo-contribution-target="boulders" class="scroll-mt-4 bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
            <legend class="sr-only"><%= t("views.mapping.photo_contributions.new.boulder_step") %></legend>
            <h2 class="text-base font-semibold leading-7 text-gray-900" aria-hidden="true"><%= t("views.mapping.photo_contributions.new.boulder_step") %></h2>
            <p class="mt-1 text-sm text-gray-600">
              <% if @wanted.any? %>
                <%= t("views.mapping.photo_contributions.new.boulder_intro", count: @wanted.size, area: @area.name) %>
              <% else %>
                <%= t("views.mapping.photo_contributions.new.boulder_none", area: @area.name) %>
              <% end %>
            </p>

            <div class="mt-4 space-y-2">
              <% @wanted.each do |row| %>
                <% boulder = row.boulder %>
                <label data-boulder="<%= boulder.id %>" class="flex items-start gap-3 rounded-md p-3 ring-1 ring-gray-200 cursor-pointer hover:bg-gray-50 has-[:checked]:ring-2 has-[:checked]:ring-granite has-[:checked]:bg-ground">
                  <%= radio_button_tag "photo_contribution[boulder_id]", boulder.id, @chosen_boulder_id == boulder.id,
                        required: true, class: "mt-1 text-granite focus:ring-granite" %>
                  <span class="flex-1 min-w-0">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1" data-badges>
                      <span class="text-sm font-medium text-gray-900"><%= boulder.name.presence || t("views.mapping.photo_contributions.new.unnamed_boulder") %></span>
                      <% if @awaiting_review.include?(boulder.id) %>
                        <span data-awaiting class="rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-800 ring-1 ring-amber-200"><%= t("views.mapping.photo_contributions.new.awaiting_review") %></span>
                      <% end %>
                      <% unless boulder.placed? %>
                        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600"><%= t("views.mapping.photo_contributions.new.not_on_map") %></span>
                      <% end %>
                    </span>
                    <% if row.problems.any? %>
                      <span class="mt-0.5 block text-xs text-gray-500">
                        <%= t("views.mapping.photo_contributions.new.problem_count", count: row.problems.size) %>:
                        <%= row.problems.first(4).map(&:name_with_fallback).compact_blank.join(", ") %><% if row.problems.size > 4 %><%= t("views.mapping.photo_contributions.new.wanted_more_problems", count: row.problems.size - 4) %><% end %>
                      </span>
                    <% end %>
                  </span>
                </label>
              <% end %>

              <label class="flex items-start gap-3 rounded-md p-3 ring-1 ring-gray-200 cursor-pointer hover:bg-gray-50 has-[:checked]:ring-2 has-[:checked]:ring-granite has-[:checked]:bg-ground">
                <%= radio_button_tag "photo_contribution[boulder_id]", "", @wanted.empty?, required: true, id: "photo_contribution_boulder_id_other",
                      class: "mt-1 text-granite focus:ring-granite" %>
                <span class="flex-1">
                  <span class="block text-sm font-medium text-gray-900"><%= t("views.mapping.photo_contributions.new.other_boulder") %></span>
                  <span class="mt-0.5 block text-xs text-gray-500"><%= t("views.mapping.photo_contributions.new.other_boulder_hint") %></span>
                </span>
              </label>
            </div>
            <%= link_to t("views.mapping.photo_contributions.new.wanted_see_map"), mapping_map_path(slug: @area.slug),
                  class: "mt-4 inline-block text-sm font-medium text-granite underline" %>
          </fieldset>

          <section data-photo-contribution-target="picker" class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
            <h2 class="text-base font-semibold leading-7 text-gray-900"><%= t("views.mapping.photo_contributions.new.photos_step") %></h2>

            <details class="mt-2 mb-4 text-sm text-gray-600">
              <summary class="cursor-pointer font-medium text-granite"><%= t("views.mapping.photo_contributions.new.tips_title") %></summary>
              <div class="mt-3"><%= render "mapping/contributions/how_to_boulder" %></div>
            </details>

            <label data-photo-contribution-target="dropzone"
                   data-action="dragover->photo-contribution#dragOver dragleave->photo-contribution#dragLeave drop->photo-contribution#drop"
                   class="flex flex-col items-center justify-center gap-2 p-8 border-2 border-dashed border-gray-300 rounded-md bg-white text-gray-500 cursor-pointer hover:border-granite transition-colors text-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="text-base font-medium text-gray-700"><%= t("views.mapping.photo_contributions.new.dropzone") %></span>
              <span class="text-xs"><%= t("views.mapping.photo_contributions.new.dropzone_hint", size: PhotoContribution::MAX_SIZE / 1.megabyte) %></span>
              <input type="file" multiple accept="<%= PhotoContribution::CONTENT_TYPES.join(",") %>" class="sr-only"
                     data-photo-contribution-target="input" data-action="change->photo-contribution#choose">
            </label>

            <ul data-photo-contribution-target="list" class="mt-4 divide-y divide-gray-200 empty:hidden ring-1 ring-gray-200 rounded-md"></ul>
            <p class="mt-3 text-xs text-gray-500"><%= t("views.mapping.photo_contributions.new.privacy") %></p>
          </section>

          <section data-photo-contribution-target="about" class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-xl px-4 py-6 sm:p-8">
            <h2 class="text-base font-semibold leading-7 text-gray-900"><%= t("views.mapping.photo_contributions.new.about_step") %></h2>
            <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <%= form.label :contributor_name, t("views.mapping.photo_contributions.new.name_label"), class: "block text-sm font-medium leading-6 text-gray-900" %>
                <%= form.text_field :contributor_name, maxlength: 100, autocomplete: "name", class: "mt-2 #{input_class}" %>
                <p class="mt-1.5 text-xs text-gray-500">
                  <%= t("views.mapping.contributions.new.leaderboard_hint_html",
                        link: link_to(t("views.mapping.contributions.new.leaderboard_link"), mapping_path(anchor: "contributors"), class: "underline hover:text-gray-700")) %>
                </p>
              </div>
              <div>
                <%= form.label :contributor_email, t("views.mapping.photo_contributions.new.email_label"), class: "block text-sm font-medium leading-6 text-gray-900" %>
                <%= form.email_field :contributor_email, autocomplete: "email", class: "mt-2 #{input_class}" %>
                <p class="mt-1.5 text-xs text-gray-500"><%= t("views.mapping.photo_contributions.new.email_hint") %></p>
              </div>
              <div class="sm:col-span-2">
                <%= form.label :comment, t("views.mapping.photo_contributions.new.comment_label"), class: "block text-sm font-medium leading-6 text-gray-900" %>
                <%= form.text_area :comment, rows: 3, maxlength: 1000, placeholder: t("views.mapping.photo_contributions.new.comment_placeholder"), class: "mt-2 #{input_class}" %>
              </div>
            </div>
          </section>

          <div class="px-4 sm:px-0 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3">
            <p data-photo-contribution-target="summary" class="text-sm text-gray-600" aria-live="polite"></p>
            <button type="submit" data-photo-contribution-target="sendButton" disabled
                    class="flex w-full sm:w-64 justify-center rounded-md bg-granite px-3 py-2 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-granite-dark disabled:opacity-50 disabled:cursor-not-allowed">
              <%= t("views.mapping.photo_contributions.new.submit") %>
            </button>
          </div>

          <section data-photo-contribution-target="done" class="hidden rounded-xl bg-ground ring-1 ring-granite/20 px-4 py-6 sm:p-8" tabindex="-1">
            <h2 class="text-lg font-semibold text-granite-dark"><%= t("views.mapping.photo_contributions.new.done_title") %></h2>
            <p class="mt-2 text-sm text-gray-700" data-photo-contribution-target="doneText"></p>
            <p class="mt-2 text-sm text-gray-700"><%= t("views.mapping.photo_contributions.new.done_body") %></p>
            <button type="button" data-action="photo-contribution#reset" class="mt-4 text-sm font-medium text-granite underline">
              <%= t("views.mapping.photo_contributions.new.add_more") %>
            </button>
          </section>
        <% end %>
      <% end %>
    </div>

  </div>
</div>
