<% set_meta_tags title: t("views.homepage.metas.title") %>
<% set_meta_tags description: t("views.homepage.metas.description") %>

<% set_meta_tags og: { type: "website", image: image_url("hero-homepage.jpg") } %>

<%# Hero band: granite, edge to edge %>
<section class="bg-granite text-white">
  <div class="max-w-site mx-auto px-6 py-14 grid gap-10 sm:grid-cols-2 sm:items-center">
    <div class="flex flex-col gap-5">
      <p class="text-sm font-semibold tracking-[0.14em] uppercase text-on-dark-muted">Devon · granite</p>
      <h1 class="text-[2.75rem] sm:text-[3.5rem] font-extrabold tracking-[-0.03em] leading-[1.02]">
        <%= t("views.homepage.title1") %> <%= t("views.homepage.title2") %>
      </h1>
      <p class="text-xl text-on-dark"><%= t("views.homepage.subtitle") %></p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href="<%= map_path %>" class="inline-flex items-center gap-2 h-12 px-5 rounded-[10px] bg-white text-granite font-bold hover:bg-ground">
          <%= t("views.homepage.see_map") %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
        <p class="text-on-dark-muted">
          <span class="font-extrabold text-white"><%= @problem_count %></span> problems across
          <span class="font-extrabold text-white"><%= @area_count %></span> areas
        </p>
      </div>
    </div>
    <%= image_tag "hero-homepage.jpg", alt: "A climber bouldering on Dartmoor granite", class: "w-full h-[340px] rounded-2xl object-cover" %>
  </div>
</section>

<div class="max-w-site mx-auto px-6 pt-12 pb-16 flex flex-col gap-14">
  <%# Saved for offline: shown by saved-areas once something has been saved %>
  <div data-controller="saved-areas" data-saved-areas-versions-value="<%= @offline_versions.to_json %>"
       class="hidden bg-white border border-line rounded-2xl p-6">
    <div class="flex flex-wrap items-start justify-between gap-5">
      <div class="flex items-start gap-4 min-w-0">
        <div class="flex items-center justify-center shrink-0 w-11 h-11 rounded-[10px] bg-ground text-stone">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
        </div>
        <div class="min-w-0">
          <h2 class="text-xl font-extrabold">Saved for offline</h2>
          <p class="text-muted">Areas you've saved to use without signal.</p>
          <ul data-saved-areas-target="list" class="mt-2 space-y-1"></ul>
        </div>
      </div>
      <a href="<%= downloads_path %>" class="inline-flex items-center h-11 px-4 rounded-[10px] border-2 border-granite text-granite font-bold hover:bg-granite hover:text-white">
        Manage downloads
      </a>
    </div>
  </div>
  <%= render "shared/install_prompt" %>

  <section>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-5">
      <h2 class="text-[32px] font-extrabold tracking-[-0.02em]"><%= t("views.homepage.popular_areas") %></h2>
      <a href="<%= areas_path %>" class="inline-flex items-center min-h-[44px] font-semibold text-granite hover:text-granite-dark hover:underline">
        <%= t("views.homepage.all_areas") %>
      </a>
    </div>
    <div class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(210px,1fr))]">
      <% Area.with_ids_keep_order(@popular_areas_ids).each do |area| %>
        <%= link_to area_path(area), class: "group block bg-white border border-line rounded-[14px] overflow-hidden hover:border-stone" do %>
          <% if area.cover.persisted? %>
            <img src="<%= cdn_image_url(area.cover.variant(:thumb)) %>" alt="" loading="lazy" class="block w-full h-[140px] object-cover bg-photo">
          <% else %>
            <div class="h-[140px] bg-photo"></div>
          <% end %>
          <div class="flex items-center justify-between gap-2 px-4 py-3">
            <span class="text-lg font-bold text-granite group-hover:text-granite-dark"><%= area.name %></span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0 text-stone" aria-hidden="true">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(260px,1fr))]">
    <% [
         [ethics_path, "banner-app-outdoors.jpg", "ethics"],
         [beginners_guide_path, "banner-shoes.jpg", "beginners_guide"],
         [about_path, "hero-about.jpg", "about"]
       ].each do |path, banner, key| %>
      <a href="<%= path %>" class="group flex flex-col bg-white border border-line rounded-2xl overflow-hidden hover:border-stone">
        <%= image_tag banner, alt: "", class: "h-48 w-full object-cover bg-photo" %>
        <div class="flex flex-1 flex-col gap-2 p-6">
          <h3 class="text-xl font-extrabold"><%= t("views.homepage.promoted.#{key}.title") %></h3>
          <p class="text-muted"><%= t("views.homepage.promoted.#{key}.subtitle") %></p>
          <span class="mt-auto pt-2 font-semibold text-granite group-hover:text-granite-dark group-hover:underline"><%= t("views.homepage.promoted.#{key}.cta") %></span>
        </div>
      </a>
    <% end %>
  </section>
</div>
