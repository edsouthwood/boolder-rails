[Unit]
Description=Boolder Rails Server (production)
After=network.target postgresql.service
# Never stop retrying: an OS package upgrade can restart PostgreSQL for longer
# than the default start-limit window, and giving up leaves the site down.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/ed/projects/boolder-rails
Environment="PATH=/home/ed/.rbenv/shims:/home/ed/.rbenv/bin:/home/ed/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RBENV_ROOT=/home/ed/.rbenv"
Environment="RAILS_ENV=production"
# Run Solid Queue inside Puma so background jobs (emails) work without a separate worker.
Environment="SOLID_QUEUE_IN_PUMA=true"
EnvironmentFile=/home/ed/projects/boolder-rails/.env
# Bind to localhost only: all external traffic must come through Caddy (TLS).
ExecStart=/home/ed/.rbenv/shims/bundle exec rails server -b 127.0.0.1 -p 3000
# Restart=always, not on-failure: when PostgreSQL goes away (e.g. unattended-upgrades
# restarting it), the Solid Queue Puma plugin shuts Puma down *cleanly* (exit 0), which
# on-failure ignores. That took the site down silently for 8 days on 2026-08-21.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
